# ─────────────────────────────────────────────────────────────
#  WrapUrs — environment variables
#  Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
#  Database — Neon PostgreSQL (Phase 2 of admin-dashboard plan)
#  Create your free project at https://neon.tech, then copy the
#  two connection strings from the Neon dashboard into `.env`.
#
#  WHY `.env` AND NOT `.env.local`?
#  The Prisma CLI (migrations, studio) reads `.env` only.
#  Next.js reads `.env` as well as `.env.local`, so putting the
#  database URLs in `.env` makes both tools work with one file.
#  NEVER commit real credentials — `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# POOLED connection string — used by the Next.js app at runtime.
# (Neon dashboard → Connect → Pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT connection string — used only by Prisma CLI for migrations.
# (Neon dashboard → Connect → Direct connection string)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth (Auth.js v5) — credentials + Google OAuth
# Leave Google keys blank to hide "Continue with Google". AUTH_SECRET is required in production.
AUTH_SECRET="change-this-to-a-long-random-string"
NEXTAUTH_SECRET="change-this-to-a-long-random-string"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Admin access — comma-separated list of account emails that receive the
# ADMIN role. Elevation applies ONLY after that account logs in successfully
# through the normal sign-in flow, and NEVER to the public demo account.
# Restart the dev server after changing this, then sign in again.
ADMIN_EMAILS=""

# Media — Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Email — Resend
RESEND_API_KEY=""
EMAIL_FROM="WrapUrs <hello@wrapurs.com>"

# Feature flags
NEXT_PUBLIC_ENABLE_COD="true"
NEXT_PUBLIC_ENABLE_RAZORPAY="true"
