# ─────────────────────────────────────────────────────────────
#  WrapUrs — environment variables
#  Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database (PostgreSQL — Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/wrapurs"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth (Auth.js v5) — credentials + Google OAuth
# Leave Google keys blank to hide "Continue with Google". AUTH_SECRET is required in production.
AUTH_SECRET="change-this-to-a-long-random-string"
NEXTAUTH_SECRET="change-this-to-a-long-random-string"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Media — Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Email — Resend
RESEND_API_KEY=""
EMAIL_FROM="WrapUrs <hello@wrapurs.com>"

# Feature flags
NEXT_PUBLIC_ENABLE_COD="true"
NEXT_PUBLIC_ENABLE_RAZORPAY="true"
